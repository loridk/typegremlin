{
  "manifest_version": 3,
  "name": "TypeGremlin",
  "version": "0.1.0",
  "description": "A privacy-first, open-source text expander for your browser.",
  "options_page": "options/options.html",
  "permissions": ["storage"],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"]
    }
  ]
}
